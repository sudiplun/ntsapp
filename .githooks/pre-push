#!/usr/bin/env bash
#
# Note Safe pre-push Git hook.
# Runs sanity checks (formatting, analysis, tests, secrets) before code is pushed to remote.
#

set -e

# ANSI Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

echo -e "\n${BOLD}${BLUE}=== Running pre-push verification ===${NC}"

# Check for required tools
if ! command -v flutter >/dev/null 2>&1; then
  echo -e "${YELLOW}⚠️  Flutter command not found on PATH. Skipping Flutter pre-push checks.${NC}"
  exit 0
fi

# 1. Check for accidental secrets / tracked .env or keystore files
echo -ne "${BLUE}[1/4] Checking for sensitive files...${NC} "
SENSITIVE_FILES=$(git ls-files --error-unmatch .env '*.jks' '*.keystore' '*key.properties' 2>/dev/null || true)
if [ -n "$SENSITIVE_FILES" ]; then
  echo -e "${RED}FAILED${NC}"
  echo -e "${RED}❌ Error: Sensitive files are tracked by git! Remove them from git tracking before pushing:${NC}"
  echo "   $SENSITIVE_FILES"
  echo "   git rm --cached <file>"
  exit 1
fi
echo -e "${GREEN}OK${NC}"

# 2. Check code formatting
echo -ne "${BLUE}[2/4] Checking code formatting (dart format)...${NC} "
if ! dart format --output=none --set-exit-if-changed lib test >/dev/null 2>&1; then
  echo -e "${RED}FAILED${NC}"
  echo -e "${RED}❌ Error: Unformatted code detected in lib/ or test/.${NC}"
  echo -e "${YELLOW}👉 Run the following command to auto-format your files:${NC}"
  echo -e "   dart format lib test\n"
  exit 1
fi
echo -e "${GREEN}OK${NC}"

# 3. Static analysis
echo -ne "${BLUE}[3/4] Running static analysis (flutter analyze)...${NC} "
ANALYSIS_OUTPUT=$(flutter analyze --no-fatal-infos 2>&1)
ANALYSIS_EXIT=$?
if [ $ANALYSIS_EXIT -ne 0 ]; then
  echo -e "${RED}FAILED${NC}"
  echo -e "${RED}❌ Error: Static analysis found issues:${NC}"
  echo "$ANALYSIS_OUTPUT"
  exit 1
fi
echo -e "${GREEN}OK${NC}"

# 4. Unit tests
echo -ne "${BLUE}[4/4] Running automated tests (flutter test)...${NC} "
TEST_OUTPUT=$(flutter test 2>&1)
TEST_EXIT=$?
if [ $TEST_EXIT -ne 0 ]; then
  echo -e "${RED}FAILED${NC}"
  echo -e "${RED}❌ Error: Test suite failed:${NC}"
  echo "$TEST_OUTPUT"
  exit 1
fi
echo -e "${GREEN}OK${NC}"

echo -e "${BOLD}${GREEN}✅ All pre-push checks passed! Proceeding with push.${NC}\n"
exit 0
